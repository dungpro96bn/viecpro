{
  "name": "viecpro",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "npm run build -w @viecpro/shared",
    "dev": "concurrently -k -n shared,api,web,admin -c gray,magenta,cyan,yellow \"npm:dev:shared\" \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:admin\"",
    "dev:shared": "npm run dev -w @viecpro/shared",
    "dev:api": "npm run start:dev -w @viecpro/api",
    "dev:web": "npm run dev -w @viecpro/web",
    "build": "npm run build -w @viecpro/shared && npm run build -w @viecpro/api && npm run build -w @viecpro/web && npm run build -w @viecpro/admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @viecpro/api",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @viecpro/api",
    "db:seed": "npm run db:seed -w @viecpro/api",
    "db:studio": "npm run db:studio -w @viecpro/api",
    "dev:admin": "npm run dev -w @viecpro/admin"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
