# ---------- App ----------
NODE_ENV=development
PORT=4000
# Origin web được gọi API (CORS), cách nhau bởi dấu phẩy
CORS_ORIGINS=http://localhost:3100,http://localhost:3001
# URL gốc để ghép đường dẫn ảnh thành URL tuyệt đối (mobile cần)
ASSET_BASE_URL=http://localhost:3100
# Kho tệp: local = lưu vào LOCAL_STORAGE_DIR (apps/api/storage), API phục vụ ở API_PUBLIC_URL/files/… (chỉ dev)
#          s3 = S3 / R2 qua presigned URL (bắt buộc ở production)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=storage
API_PUBLIC_URL=http://localhost:4000
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- Database ----------
DATABASE_URL=postgresql://viecpro:viecpro@localhost:5433/viecpro?schema=public
REDIS_URL=

# ---------- Auth ----------
# Chuỗi ngẫu nhiên >= 32 ký tự: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL=900
REFRESH_TTL_DAYS=30
OTP_SECRET=change-me-otp-secret-at-least-32-characters-long
# Khoá mã hoá bí mật 2FA của admin – KHÁC 2 khoá trên
ADMIN_MFA_KEY=change-me-admin-mfa-key-at-least-32-characters
# Chỉ để true tạm thời khi kiểm thử local; production từ chối cờ này
ADMIN_MFA_BYPASS=false
# IP được vào API admin ở production (vd. IP văn phòng), cách nhau dấu phẩy. Trống = không giới hạn
ADMIN_IP_ALLOWLIST=

# ---------- Gửi OTP ----------
# console = in mã ra log (dev) | sms = Twilio Programmable Messaging
# Cũng dùng cho SMS thông báo việc làm: console thì in nội dung tin ra log
OTP_PROVIDER=console
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM=

# ---------- Email ----------
# console = ghi email ra apps/api/tmp/mail/*.html để xem trước (dev) | resend = gửi thật qua Resend
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=viecpro <no-reply@viecpro.vn>
# URL trang web dùng cho link trong email
WEB_BASE_URL=http://localhost:3100

# ---------- Push ----------
# log = dev, fcm = Firebase Cloud Messaging HTTP v1
PUSH_PROVIDER=log
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Lưu private key dạng nhiều dòng hoặc dùng \n cho dấu xuống dòng
FCM_PRIVATE_KEY=

# ---------- Google ----------
GOOGLE_CLIENT_ID=

# ---------- App mobile ----------
APP_MIN_VERSION_IOS=1.0.0
APP_MIN_VERSION_ANDROID=1.0.0
APP_LATEST_VERSION_IOS=1.0.0
APP_LATEST_VERSION_ANDROID=1.0.0
APP_STORE_URL_IOS=
APP_STORE_URL_ANDROID=

# Worker gửi thông báo việc làm (5 phút / lần). Chạy nhiều instance: chỉ bật ở 1 instance
JOB_ALERT_WORKER=true
